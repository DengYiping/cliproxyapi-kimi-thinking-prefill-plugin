+            raise ValueError(f"malformed: bad cmdsize {cmdsize} at 0x{off:x}")
+        if cmd == LC_SEGMENT_64:
+            (segname, vmaddr, vmsize, fileoff, filesize,
+             _mp, _ip, nsects, _fl) = struct.unpack_from("<16sQQQQiiII", buf, off + 8)
+            result["segments"].append({
+                "name": segname.rstrip(b"\x00").decode(), "vmaddr": vmaddr,
+                "vmsize": vmsize, "fileoff": fileoff, "filesize": filesize,
+                "nsects": nsects})
+        elif cmd == LC_DYSYMTAB:
+            fields = struct.unpack_from("<18I", buf, off + 8)
+            result["relocations"] = {
+                "extreloff": fields[14], "nextrel": fields[15],
+                "locreloff": fields[16], "nlocrel": fields[17]}
+        elif cmd == LC_LOAD_DYLINKER:
+            (name_off,) = struct.unpack_from("<I", buf, off + 8)
+            if name_off >= cmdsize:
+                raise ValueError("malformed: dylinker name offset out of record")
+            raw = buf[off + name_off:off + cmdsize].split(b"\x00")[0]
+            result["dylinker"] = raw.decode()
+        elif cmd == LC_UUID:
+            result["uuid"] = str(uuid_mod.UUID(bytes=buf[off + 8:off + 24]))
+        off += cmdsize
+    if len(result["segments"]) != NSEGS:
+        raise ValueError("malformed: unexpected segment count")
+    return result
+
+
+def validate(parsed: dict) -> list:
+    """Bounded validator: concrete expected values for this fixture."""
+    checks = [
+        ("magic == MH_MAGIC_64", parsed["magic"] == MH_MAGIC_64),
+        ("segment_count == 2", len(parsed["segments"]) == NSEGS),
+        ("dylinker == /usr/lib/dyld", parsed["dylinker"] == FIXTURE_DYLINKER),
+        ("uuid == fixture", parsed["uuid"] == str(FIXTURE_UUID)),
+        ("external relocs == 0x10", parsed["relocations"]["nextrel"] == 0x10),
+        ("local relocs == 0x08", parsed["relocations"]["nlocrel"] == 0x08),
+    ]
+    return checks
+
+
+def main() -> int:
