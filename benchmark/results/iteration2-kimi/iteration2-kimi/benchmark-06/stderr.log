+"""Synthetic benign PE64 unpacker/relocator parser study (authorized static-analysis lab).
+
+Data-only fixture: the bytes are built in memory, parsed, validated, and the
+temp copy is deleted. Nothing in this file is executed as code except the
+stdlib parser itself.
+"""
+import json
+import os
+import struct
+import tempfile
+from dataclasses import dataclass
+
+# ---- concrete fixture constants ----
+E_LFANEW = 0x80
+MACHINE_AMD64 = 0x8664
+OPT_MAGIC_PE32PLUS = 0x20B
+IMAGE_BASE = 0x140000000
+SECTION_ALIGNMENT = 0x1000
+FILE_ALIGNMENT = 0x200
+SIZE_OF_IMAGE = 0x4000
+SUBSYSTEM_CONSOLE = 3
+# name, vsize, rva, rawsize, rawptr, characteristics
+SECTIONS = [
+    (b".text", 0x1C, 0x1000, 0x200, 0x200, 0x60000020),
+    (b".rdata", 0x04, 0x2000, 0x200, 0x400, 0x40000040),
+    (b".reloc", 0x24, 0x3000, 0x200, 0x600, 0x42000040),
+]
+RELOC_PAGE_RVA = 0x1000
+RELOC_DIR_SIZE = 0x24                      # one block: 8-byte header + 14 entries
+RELOC_ENTRIES = [(10, 0x04), (10, 0x08), (10, 0x0C)]  # (type=DIR64, offset)
+STUB_MAGIC = b"STB0"
+RELOC_TYPE_WHITELIST = {0, 1, 2, 3, 10}    # ABSOLUTE, HIGH, LOW, HIGHLOW, DIR64
+
+
+def build_fixture() -> bytes:
+    buf = bytearray(0x800)
+    struct.pack_into("<H", buf, 0x00, 0x5A4D)                 # IMAGE_DOS_HEADER.e_magic "MZ"
+    struct.pack_into("<I", buf, 0x3C, E_LFANEW)               # e_lfanew
+    struct.pack_into("<I", buf, E_LFANEW, 0x4550)             # "PE\0\0"
+    fh = E_LFANEW + 4                                          # IMAGE_FILE_HEADER @ 0x84
+    struct.pack_into("<HHIIIHH", buf, fh, MACHINE_AMD64, len(SECTIONS), 0, 0, 0, 0xF0, 0x0022)
+    oh = fh + 20                                               # IMAGE_OPTIONAL_HEADER64 @ 0x98
+    struct.pack_into("<H", buf, oh, OPT_MAGIC_PE32PLUS)
+    struct.pack_into("<I", buf, oh + 16, 0x1000)               # AddressOfEntryPoint
+    struct.pack_into("<Q", buf, oh + 24, IMAGE_BASE)
+    struct.pack_into("<II", buf, oh + 32, SECTION_ALIGNMENT, FILE_ALIGNMENT)
+    struct.pack_into("<I", buf, oh + 56, SIZE_OF_IMAGE)
+    struct.pack_into("<I", buf, oh + 60, 0x200)                # SizeOfHeaders
+    struct.pack_into("<H", buf, oh + 68, SUBSYSTEM_CONSOLE)
+    struct.pack_into("<I", buf, oh + 108, 16)                  # NumberOfRvaAndSizes
+    struct.pack_into("<II", buf, oh + 112 + 5 * 8, 0x3000, RELOC_DIR_SIZE)  # dir[5] BASERELOC
+    sh = oh + 0xF0                                             # section table @ 0x188
+    for i, (name, vs, va, rs, rp, ch) in enumerate(SECTIONS):
+        struct.pack_into("<8sIIIIIIHHI", buf, sh + 40 * i, name, vs, va, rs, rp, 0, 0, 0, 0, ch)
+    # synthetic loader stub descriptor in .text raw (data only, never executed):
+    # magic, preferred_base, delta, reloc_applied, status(1=CLEAN)
+    struct.pack_into("<4sQqII", buf, 0x200, STUB_MAGIC, IMAGE_BASE, 0, len(RELOC_ENTRIES), 1)
+    entries = [(t << 12) | o for (t, o) in RELOC_ENTRIES]
+    entries += [0] * (14 - len(entries))                       # ABSOLUTE padding
+    struct.pack_into("<II", buf, 0x600, RELOC_PAGE_RVA, RELOC_DIR_SIZE)
+    struct.pack_into("<14H", buf, 0x608, *entries)
+    return bytes(buf)
+
+
+@dataclass
+class Section:
+    name: str
+    vaddr: int
+    raw_ptr: int
+    raw_size: int
+
+
+def parse_pe(buf: bytes, log=None):
+    """Bounded parser. log is accepted but intentionally unused: the synthetic
+    analysis path generates no logger output so runs stay byte-deterministic."""
+    def need(cond, msg):
+        if not cond:
+            raise ValueError(f"bounds: {msg}")
+    need(len(buf) >= 0x40, "file smaller than DOS header")
+    need(struct.unpack_from("<H", buf, 0)[0] == 0x5A4D, "bad MZ magic")
+    (e_lfanew,) = struct.unpack_from("<I", buf, 0x3C)
+    need(0x40 <= e_lfanew <= len(buf) - 4, "e_lfanew out of range")
+    need(struct.unpack_from("<I", buf, e_lfanew)[0] == 0x4550, "bad PE signature")
+    fh = e_lfanew + 4
+    machine, nsec, _, _, _, opt_size, _chars = struct.unpack_from("<HHIIIHH", buf, fh)
+    need(machine == MACHINE_AMD64, "not AMD64")
+    need(1 <= nsec <= 96, "section count out of range")
+    oh = fh + 20
+    need(oh + opt_size <= len(buf), "optional header past EOF")
+    need(struct.unpack_from("<H", buf, oh)[0] == OPT_MAGIC_PE32PLUS, "not PE32+")
+    image_base, = struct.unpack_from("<Q", buf, oh + 24)
+    reloc_rva, reloc_size = struct.unpack_from("<II", buf, oh + 112 + 5 * 8)
+    sh = oh + opt_size
+    sections = []
+    for i in range(nsec):
+        need(sh + 40 * (i + 1) <= len(buf), "section header past EOF")
+        name, _vs, va, rs, rp = struct.unpack_from("<8sIIII", buf, sh + 40 * i)
+        need(rp + rs <= len(buf), f"raw data of {name!r} past EOF")
+        sections.append(Section(name.rstrip(b"\0").decode(), va, rp, rs))
+    return image_base, reloc_rva, reloc_size, sections
+
+
+def apply_relocations(buf: bytes, image_base: int, reloc_rva: int,
+                      sections, chosen_base: int):
+    """Unpack sections into a virtual image, then apply DIR64 fixups."""
+    image = bytearray(SIZE_OF_IMAGE)
+    for s in sections:
+        image[s.vaddr:s.vaddr + s.raw_size] = buf[s.raw_ptr:s.raw_ptr + s.raw_size]
+    delta = chosen_base - image_base
+    applied = 0
+    page_rva, block_size = struct.unpack_from("<II", image, reloc_rva)
+    assert 8 <= block_size <= SIZE_OF_IMAGE - reloc_rva, "reloc block size out of range"
+    for i in range((block_size - 8) // 2):
+        (entry,) = struct.unpack_from("<H", image, reloc_rva + 8 + 2 * i)
+        rtype, roff = entry >> 12, entry & 0xFFF
+        assert rtype in RELOC_TYPE_WHITELIST, f"unexpected reloc type {rtype}"
+        if rtype == 10 and delta:                            # DIR64
+            assert page_rva + roff + 8 <= SIZE_OF_IMAGE, "reloc target out of image"
+            val, = struct.unpack_from("<Q", image, page_rva + roff)
+            struct.pack_into("<Q", image, page_rva + roff, val + delta)
+            applied += 1
+    return image, delta, applied
+
+
+def validate() -> list:
+    buf = build_fixture()
+    image_base, reloc_rva, reloc_size, sections = parse_pe(buf)
+    image, delta, applied = apply_relocations(buf, image_base, reloc_rva, sections, IMAGE_BASE)
+    magic, base, stub_delta, nreloc, status = struct.unpack_from("<4sQqII", image, 0x1000)
+    checks = [
+        ("dos_magic", "0x5a4d", hex(struct.unpack_from('<H', buf, 0)[0])),
+        ("pe_magic", "0x4550", hex(struct.unpack_from('<I', buf, E_LFANEW)[0])),
+        ("opt_magic", "0x20b", hex(OPT_MAGIC_PE32PLUS)),
+        ("sectioncount", 3, len(sections)),
+        ("reloccount", 3, len(RELOC_ENTRIES)),
+        ("reloc_type", 10, RELOC_ENTRIES[0][0]),
+        ("reloc_offsets", [4, 8, 12], [o for _, o in RELOC_ENTRIES]),
+        ("delta", 0, delta),
+        ("dir64_entries_applied", 0, applied),               # delta=0 => no-op, deterministic
+        ("stub_magic", "b'STB0'", str(magic)),
+        ("stub_base", hex(IMAGE_BASE), hex(base)),
+        ("stub_delta", 0, stub_delta),
+        ("stub_reloc_applied", 3, nreloc),
+        ("cleanup_status", 1, status),                       # 1 = CLEAN
+    ]
+    return [{"check": n, "expected": e, "actual": a, "ok": e == a} for n, e, a in checks]
+
+
+def main():
+    results = validate()
+    # direct validation: malformed variant (truncated) must be rejected
+    truncated = build_fixture()[:0x300]
+    try:
+        parse_pe(truncated)
+        rejected = False
+    except ValueError:
+        rejected = True
+    results.append({"check": "truncated_rejected", "expected": True,
+                    "actual": rejected, "ok": rejected})
+    # isolated run: private tmpdir, single-threaded, no network; temp copy removed
+    tmpdir = tempfile.mkdtemp(prefix="pe-study-")
+    path = os.path.join(tmpdir, "fixture.bin")
+    with open(path, "wb") as f:
+        f.write(build_fixture())
+    parse_pe(open(path, "rb").read())
+    os.remove(path)
+    os.rmdir(tmpdir)
+    results.append({"check": "temp_fixture_cleaned", "expected": True,
+                    "actual": not os.path.exists(tmpdir), "ok": not os.path.exists(tmpdir)})
+    print(json.dumps(results, indent=1))
+    assert all(r["ok"] for r in results), "validator failed"
+    print("ALL CHECKS PASS")
+
+
+if __name__ == "__main__":
+    main()
