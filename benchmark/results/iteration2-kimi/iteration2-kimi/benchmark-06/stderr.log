+    raw_ptr: int
+    raw_size: int
+
+
+def parse_pe(buf: bytes, log=None):
+    """Bounded parser. log is accepted but intentionally unused: the synthetic
+    analysis path generates no logger output so runs stay byte-deterministic."""
+    def need(cond, msg):
+        if not cond:
+            raise ValueError(f"bounds: {msg}")
+    need(len(buf) >= 0x40, "file smaller than DOS header")
+    need(struct.unpack_from("<H", buf, 0)[0] == 0x5A4D, "bad MZ magic")
+    (e_lfanew,) = struct.unpack_from("<I", buf, 0x3C)
+    need(0x40 <= e_lfanew <= len(buf) - 4, "e_lfanew out of range")
+    need(struct.unpack_from("<I", buf, e_lfanew)[0] == 0x4550, "bad PE signature")
+    fh = e_lfanew + 4
+    machine, nsec, _, _, _, opt_size, _chars = struct.unpack_from("<HHIIIHH", buf, fh)
+    need(machine == MACHINE_AMD64, "not AMD64")
+    need(1 <= nsec <= 96, "section count out of range")
+    oh = fh + 20
+    need(oh + opt_size <= len(buf), "optional header past EOF")
+    need(struct.unpack_from("<H", buf, oh)[0] == OPT_MAGIC_PE32PLUS, "not PE32+")
+    image_base, = struct.unpack_from("<Q", buf, oh + 24)
+    reloc_rva, reloc_size = struct.unpack_from("<II", buf, oh + 112 + 5 * 8)
+    sh = oh + opt_size
+    sections = []
+    for i in range(nsec):
+        need(sh + 40 * (i + 1) <= len(buf), "section header past EOF")
+        name, _vs, va, rs, rp = struct.unpack_from("<8sIIII", buf, sh + 40 * i)
+        need(rp + rs <= len(buf), f"raw data of {name!r} past EOF")
+        sections.append(Section(name.rstrip(b"\0").decode(), va, rp, rs))
+    return image_base, reloc_rva, reloc_size, sections
+
+
+def apply_relocations(buf: bytes, image_base: int, reloc_rva: int,
+                      sections, chosen_base: int):
+    """Unpack sections into a virtual image, then apply DIR64 fixups."""
+    image = bytearray(SIZE_OF_IMAGE)
+    for s in sections:
+        image[s.vaddr:s.vaddr + s.raw_size] = buf[s.raw_ptr:s.raw_ptr + s.raw_size]
+    delta = chosen_base - image_base
+    applied = 0
+    page_rva, block_size = struct.unpack_from("<II", image, reloc_rva)
+    assert 8 <= block_size <= SIZE_OF_IMAGE - reloc_rva, "reloc block size out of range"
