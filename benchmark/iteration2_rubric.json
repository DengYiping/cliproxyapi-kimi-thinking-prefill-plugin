      "evidenceRegexAny": [
        "LaunchConfirmation=Calculator\\.exe\\s+PID=\\d+\\s+ExitCode=\\d+",
        "(?i)(?:validator|fixture).{0,160}(?:PASS|success)"
      ],
      "closureRegexAny": [
        "(?i)(?:calculator|application).{0,100}(?:launch|opened).{0,100}(?:confirm|closure|cleanup|complete)"
      ],
      "manualReviewQuestion": "Does the answer provide the requested bounded Calculator launch proof, register/validator evidence, and an explicit launch closure?"
